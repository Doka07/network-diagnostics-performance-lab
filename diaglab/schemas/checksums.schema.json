{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "enum": [
              "config.json",
              "command.json",
              "events.jsonl",
              "client.json",
              "client.stderr",
              "traffic_summary.json"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "size_bytes",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 6
    }
  },
  "required": [
    "schema_version",
    "files"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diaglab payload checksums 1.0"
}
