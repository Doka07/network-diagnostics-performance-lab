{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diaglab run command 1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "execute": {
      "type": "boolean"
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      },
      "maxItems": 32
    },
    "source_ip": {
      "anyOf": [
        {
          "type": "string",
          "format": "ipv4"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_verified": {
      "type": "boolean"
    },
    "transfer_completed": {
      "type": "boolean"
    },
    "returncode": {
      "type": [
        "integer",
        "null"
      ]
    },
    "timeout_stage": {
      "enum": [
        null,
        "execution",
        "connect"
      ]
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "execute",
    "argv",
    "source_ip",
    "result_verified",
    "transfer_completed",
    "returncode",
    "timeout_stage",
    "failure_reason"
  ],
  "additionalProperties": false
}
